@inject WorkflowUiLocalizer Ui
@page "/instances/{InstanceId:guid}"
@attribute [Authorize]
@inject IWorkflowPortalService Portal
@inject WorkflowWebIdentityAccessor Identity
@inject WorkflowMediaPortalService Media
<PageTitle>@Ui["Détail de la demande · Enterprise Workflow"]</PageTitle>
<div class="content content-medium instance-detail">
@if (_detail is null)
{
    <section class="panel empty-state"><h1>@Ui["Demande indisponible"]</h1><p>@Ui["Cette demande n’existe pas ou ne vous est pas accessible."]</p></section>
}
else
{
    <div class="page-intro"><p class="eyebrow instance-reference">No.<span id="instance-reference">@_detail.Instance.PublicReference</span> <button type="button" class="icon-button" title="@(Ui["Copier la référence"])" data-copy-target="instance-reference" aria-label="@(Ui["Copier la référence"])"><PhosphorIcon Name="copy" Size="18" /></button><span id="copy-feedback" class="visually-hidden" role="status"></span></p><h1>@_detail.Instance.ProcessTitle</h1></div>
    <WorkflowInstanceTabs InstanceId="@InstanceId" ActiveTab="@ActiveTab" />
    @if (ActiveTab == "library")
    {
        <section class="panel library-panel"><h2>@Ui["Bibliothèque"]</h2><div class="attachment-grid">
        @foreach (var item in _media)
        {
            <a class="attachment-card" aria-label="@item.Name" href="/workflow/media/@item.Reference.Id/@item.Reference.Revision"><span class="row-icon large">▤</span><strong>@item.Name</strong><small>@item.Length @Ui["octets"] · @item.CreatedAtUtc.ToLocalTime().ToString("g")</small><span>@Ui["Télécharger ↓"]</span></a>
        }
        @if (_media.Count == 0) { <div class="library-empty"><h3>@Ui["Aucune pièce jointe"]</h3><p>@Ui["Les fichiers attachés ou générés apparaîtront ici, selon vos droits."]</p></div> }
        </div></section>
    }
    else if (ActiveTab == "progress")
    {
        <section class="panel data-panel"><h2>@Ui["Progression"]</h2><div class="table-wrap"><table><thead><tr><th>@Ui["Étape"]</th><th>@Ui["État"]</th><th>@Ui["Tentative"]</th></tr></thead><tbody>
        @foreach (var step in _detail.Steps ?? []) { <tr><td>@step.Label</td><td>@Ui[step.Status.ToString()]</td><td>@step.Attempt</td></tr> }
        </tbody></table></div></section>
    }
    else if (ActiveTab == "history")
    {
        <section class="panel data-panel"><h2>@Ui["Historique récent"]</h2><p class="field-help">@Ui["Les 100 dernières opérations au maximum, dans l’ordre antéchronologique."]</p><div class="table-wrap"><table><thead><tr><th>@Ui["Date"]</th><th>@Ui["Opération"]</th><th>@Ui["Acteur"]</th></tr></thead><tbody>
        @foreach (var entry in _detail.RecentHistory ?? []) { <tr><td>@entry.OccurredAtUtc.ToLocalTime().ToString("g")</td><td>@entry.EventType</td><td>@(entry.Actor?.SubjectId ?? Ui["Système"])</td></tr> }
        </tbody></table></div></section>
    }
    else if (ActiveTab == "comments")
    {
        @foreach (var group in _detail.CommentGroups ?? [])
        {
            <section class="panel data-panel"><h2>@group.Label</h2><div class="table-wrap"><table><thead><tr><th>@Ui["Auteur"]</th><th>@Ui["Date"]</th><th>@Ui["Commentaire"]</th><th>@Ui["Étape"]</th></tr></thead><tbody>
            @foreach (var item in group.Comments) { <tr><td>@item.ActorName<small>@item.ActorId</small></td><td>@(DateTimeOffset.TryParse(item.Date, out var date) ? date.ToLocalTime().ToString("g") : "—")</td><td class="comment-text">@item.Text</td><td>@item.Stage</td></tr> }
            </tbody></table></div>@if (group.Comments.Count == 0) { <p class="comment-empty">@Ui["Aucun commentaire."]</p> }</section>
        }
        @if ((_detail.CommentGroups?.Count ?? 0) == 0) { <section class="panel empty-state comment-empty"><h2>@Ui["Aucun commentaire accessible"]</h2></section> }
    }
    else
    {
        <section class="panel data-table-panel"><table class="workflow-data-table"><caption>@Ui["Détails de la demande"]</caption><tbody>
            <tr><th scope="row">@Ui["Statut"]</th><td><span class="status @_detail.Instance.StatusClass">@Ui[_detail.Instance.StatusLabel]</span></td></tr>
            <tr><th scope="row">@Ui["Processus"]</th><td>@_detail.Instance.ProcessTitle · @VersionLabel</td></tr>
            <tr><th scope="row">@Ui["Initiateur"]</th><td>@_detail.Instance.InitiatorDisplayName<small>@_detail.Initiator?.ProviderId.Value / @_detail.Initiator?.SubjectId</small></td></tr>
            <tr><th scope="row">@Ui["Créée le"]</th><td>@_detail.Instance.CreatedAtUtc.ToLocalTime().ToString("g")</td></tr>
            <tr><th scope="row">@Ui["Dernière mise à jour"]</th><td>@_detail.Instance.UpdatedAtUtc.ToLocalTime().ToString("g")</td></tr>
            @if (_detail.Instance.BusinessKey is not null) { <tr><th scope="row">@Ui["Référence métier"]</th><td>@_detail.Instance.BusinessKey</td></tr> }
            @foreach (var field in _detail.VisibleState.ToJsonElement().EnumerateObject()) { <tr><th scope="row">@_detail.Labels.GetValueOrDefault(field.Name, field.Name)</th><td>@WorkflowDataTable.DisplayValue(field.Value, Ui["Oui"], Ui["Non"])</td></tr> }
        </tbody></table></section>
    }
}
</div>
@code {
    [Parameter] public Guid InstanceId { get; set; }
    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }
    private string VersionLabel => _detail?.Instance is { ProcessVersion: >= 1000000000 } instance
        ? string.Format(CultureInfo.CurrentCulture, Ui["génération locale g{0}"], instance.ProcessVersion - 1000000000)
        : _detail?.Instance.VersionLabel ?? string.Empty;
    private string ActiveTab => WorkflowInstanceTabs.IsKnownTab(Tab) ? Tab! : "details";
    private IReadOnlyList<WorkflowMediaItem> _media = [];
    private WorkflowInstanceDetail? _detail;
    private string StatusLabel(WorkflowInstanceStatus status) => status switch { WorkflowInstanceStatus.Completed => Ui["Terminée"], WorkflowInstanceStatus.Waiting => Ui["En attente"], WorkflowInstanceStatus.Cancelled => Ui["Annulée"], WorkflowInstanceStatus.Failed => Ui["En erreur"], _ => Ui["En cours"] };
    protected override async Task OnParametersSetAsync()
    {
        var actor = await Identity.GetRequiredAsync();
        _detail = await Portal.ReadInstanceAsync(actor, new(InstanceId), CancellationToken.None);
        _media = _detail is not null && ActiveTab == "library" ? await Media.ListAsync(actor, new(InstanceId), CancellationToken.None) : [];
    }
}
