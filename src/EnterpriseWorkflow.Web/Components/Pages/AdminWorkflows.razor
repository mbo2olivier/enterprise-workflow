@page "/admin/workflows"
@attribute [Authorize]
@inject IWorkflowPresentationCatalog Catalog
@inject IWorkflowAccessStore Access
@inject ISecurityProfileStore Profiles
@inject IAuthorizationProvider Authorization
@inject WorkflowWebIdentityAccessor Identity

<PageTitle>Habilitations · Enterprise Workflow</PageTitle>
<div class="content content-medium admin-content">
    <div class="page-intro"><p class="eyebrow">Administration</p><h1>Habilitations workflow</h1><p>Les grants ciblent une version, un nœud et une action exacts. La sémantique publiée reste immuable.</p></div>
    @if (Saved) { <div class="notice success" role="status">Politique d’accès enregistrée.</div> }
    @if (!string.IsNullOrWhiteSpace(Error)) { <div class="form-error" role="alert">La politique n’a pas été modifiée (@Error).</div> }
    @if (!_allowed)
    {
        <section class="panel empty-state"><h2>Accès refusé</h2><p>La permission de gestion des accès est requise.</p></section>
    }
    else if (_rows.Count == 0)
    {
        <section class="panel empty-state"><h2>Aucun processus installé</h2><p>Les habilitations apparaîtront après chargement d’un module métier.</p></section>
    }
    else
    {
        @foreach (var row in _rows)
        {
            <section class="panel data-panel">
                <div class="section-heading"><div><p class="eyebrow">@row.Process.Definition.Id.Value · v@row.Process.Definition.Version</p><h2>@row.Process.Title</h2></div><span class="status progress">@row.Grants.Count grant(s)</span></div>
                <div class="readonly-note"><span><strong>Définition publiée</strong><small>Modes d’affectation et séparation des acteurs en lecture seule. Seuls les grants exacts ci-dessous sont modifiables.</small></span></div>
                <div class="table-wrap"><table><thead><tr><th>Portée</th><th>Action</th><th>Bénéficiaire</th><th>Révision</th><th></th></tr></thead><tbody>
                @foreach (var grant in row.Grants)
                {
                    <tr><td>@(grant.Scope.NodeId ?? "Workflow")</td><td>@grant.Scope.Action.Value</td><td>@Recipient(grant.Recipient)</td><td>@grant.PolicyRevision</td><td>
                        <form method="post" action="/admin/workflows/grants/revoke"><AntiforgeryToken />@GrantHidden(grant)<button class="text-button danger-button" type="submit">Retirer</button></form>
                    </td></tr>
                }
                </tbody></table></div>
                <div class="grant-editors">
                    <form method="post" action="/admin/workflows/grants" class="compact-form">
                        <AntiforgeryToken /><input type="hidden" name="workflowId" value="@row.Process.Definition.Id.Value" /><input type="hidden" name="definitionVersion" value="@row.Process.Definition.Version" /><input type="hidden" name="recipientKind" value="profile" />
                        <label>Portée exacte<select name="scope" required>@foreach (var scope in Scopes(row.Process)) { <option value="@scope.Value">@scope.Label</option> }</select></label>
                        <label>Profil<select name="recipientProfileId" required>@foreach (var profile in _profiles) { <option value="@profile.Id">@profile.DisplayName</option> }</select></label>
                        <button class="primary-button" type="submit">Accorder au profil</button>
                    </form>
                    <form method="post" action="/admin/workflows/grants" class="compact-form">
                        <AntiforgeryToken /><input type="hidden" name="workflowId" value="@row.Process.Definition.Id.Value" /><input type="hidden" name="definitionVersion" value="@row.Process.Definition.Version" /><input type="hidden" name="recipientKind" value="identity" />
                        <label>Portée exacte<select name="scope" required>@foreach (var scope in Scopes(row.Process)) { <option value="@scope.Value">@scope.Label</option> }</select></label>
                        <label>Fournisseur<input name="recipientProviderId" required maxlength="128" /></label><label>Identifiant stable<input name="recipientSubjectId" required maxlength="256" /></label>
                        <button class="primary-button" type="submit">Accorder à l’identité</button>
                    </form>
                </div>
            </section>
        }
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "saved")] public string? SavedValue { get; set; }
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }
    private bool Saved => SavedValue == "1";
    private bool _allowed;
    private IReadOnlyList<SecurityProfile> _profiles = [];
    private readonly List<Row> _rows = [];

    protected override async Task OnInitializedAsync()
    {
        var actor = await Identity.GetRequiredAsync();
        _allowed = (await Authorization.AuthorizeAsync(new(actor, WorkflowPermissions.ManageAccess), CancellationToken.None)).Allowed;
        if (!_allowed) return;
        _profiles = (await Profiles.ListProfilesAsync(500, CancellationToken.None)).Value ?? [];
        foreach (var process in Catalog.Processes)
        {
            var grants = await Access.ListAsync(process.Definition.Id.Value, process.Definition.Version, CancellationToken.None);
            _rows.Add(new(process, grants.Value ?? []));
        }
    }

    private static IEnumerable<ScopeOption> Scopes(WorkflowProcessDescriptor process)
    {
        yield return new("~|workflow.start", "Workflow · démarrer");
        yield return new("~|instance.read", "Workflow · lire une instance");
        yield return new("~|instance.cancel", "Workflow · annuler une instance");
        foreach (var node in process.Definition.Nodes.Where(item => item.HumanTask is not null))
        {
            yield return new($"{node.Id.Value}|task.read", $"{node.DisplayLabel ?? node.Id.Value} · lire");
            yield return new($"{node.Id.Value}|task.claim", $"{node.DisplayLabel ?? node.Id.Value} · claim");
            yield return new($"{node.Id.Value}|task.assign", $"{node.DisplayLabel ?? node.Id.Value} · affecter");
            foreach (var action in node.HumanTask!.Actions)
                yield return new($"{node.Id.Value}|{action.ActionId.Value}", $"{node.DisplayLabel ?? node.Id.Value} · {action.ActionId.Value}");
        }
    }

    private static RenderFragment GrantHidden(WorkflowAccessGrant grant) => builder =>
    {
        var sequence = 0;
        Hidden(builder, ref sequence, "workflowId", grant.Scope.WorkflowId);
        Hidden(builder, ref sequence, "definitionVersion", grant.Scope.DefinitionVersion.ToString(CultureInfo.InvariantCulture));
        Hidden(builder, ref sequence, "nodeId", grant.Scope.NodeId ?? string.Empty);
        Hidden(builder, ref sequence, "actionId", grant.Scope.Action.Value);
        Hidden(builder, ref sequence, "recipientKind", grant.Recipient.Kind is WorkflowGrantRecipientKind.Profile ? "profile" : "identity");
        Hidden(builder, ref sequence, "recipientProfileId", grant.Recipient.ProfileId ?? string.Empty);
        Hidden(builder, ref sequence, "recipientProviderId", grant.Recipient.Identity?.ProviderId ?? string.Empty);
        Hidden(builder, ref sequence, "recipientSubjectId", grant.Recipient.Identity?.SubjectId ?? string.Empty);
    };

    private static void Hidden(RenderTreeBuilder builder, ref int sequence, string name, string value)
    {
        builder.OpenElement(sequence++, "input"); builder.AddAttribute(sequence++, "type", "hidden");
        builder.AddAttribute(sequence++, "name", name); builder.AddAttribute(sequence++, "value", value); builder.CloseElement();
    }

    private static string Recipient(WorkflowGrantRecipient recipient) => recipient.Kind is WorkflowGrantRecipientKind.Profile
        ? $"Profil · {recipient.ProfileId}"
        : $"Identité · {recipient.Identity!.Value.ProviderId}/{recipient.Identity.Value.SubjectId}";
    private sealed record ScopeOption(string Value, string Label);
    private sealed record Row(WorkflowProcessDescriptor Process, IReadOnlyList<WorkflowAccessGrant> Grants);
}
