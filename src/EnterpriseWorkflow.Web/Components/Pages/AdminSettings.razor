@page "/admin/settings"
@attribute [Authorize]
@using EnterpriseWorkflow.Runtime
@using Microsoft.Extensions.Options
@inject IPresentationSettingsStore SettingsStore
@inject IAuthorizationProvider Authorization
@inject WorkflowWebIdentityAccessor Identity
@inject IConfiguration Configuration
@inject SecurityPolicyOptions SecurityPolicy
@inject IOptions<WorkflowRuntimeOptions> RuntimeOptions

<PageTitle>Réglages · Enterprise Workflow</PageTitle>
<div class="content content-small admin-content">
    <div class="admin-page-intro"><div><p class="eyebrow">Installation</p><h1>Réglages</h1><p>Personnalisez l’interface et consultez la configuration effective.</p></div></div>
    @if (!_allowed) { <section class="panel empty-state"><h2>Accès refusé</h2><p>La permission de gestion des accès est requise.</p></section> }
    else
    {
        <form method="post" action="/admin/settings/update" class="settings-form"><AntiforgeryToken /><input type="hidden" name="revision" value="@_settings.Revision" /><input type="hidden" name="logoResourcePath" value="@_settings.LogoResourcePath" /><input type="hidden" name="culture" value="@_settings.Culture" />
            <section class="panel settings-panel"><div class="section-heading"><div><p class="eyebrow">Apparence</p><h2>Identité de l’installation</h2></div></div><div class="settings-fields"><label>Nom affiché<input name="displayName" value="@_settings.DisplayName" required maxlength="160" /></label><label>Fuseau horaire<select name="timeZoneId" required><option selected="@(_settings.TimeZoneId == "Africa/Kinshasa")">Africa/Kinshasa</option><option selected="@(_settings.TimeZoneId == "UTC")">UTC</option>@if (_settings.TimeZoneId is not "Africa/Kinshasa" and not "UTC") { <option selected>@_settings.TimeZoneId</option> }</select></label><div class="setting-row"><span><strong>Couleur d’accent</strong><small>Utilisée pour les actions et les états sélectionnés.</small></span><label class="color-swatch"><span class="color-preview" style="background:@_settings.AccentColor"></span><input name="accentColor" value="@_settings.AccentColor" required pattern="#[0-9A-Fa-f]{6}" aria-label="Couleur d’accent" /></label></div></div></section>
            <section class="panel settings-panel"><div class="section-heading"><div><p class="eyebrow">Sessions</p><h2>Politique de sécurité</h2></div></div><div class="settings-fields"><div class="field-grid"><label>Inactivité maximale<select disabled><option>@DurationLabel(SecurityPolicy.IdleSessionTimeout)</option></select></label><label>Durée maximale<select disabled><option>@DurationLabel(SecurityPolicy.AbsoluteSessionLifetime)</option></select></label></div><div class="setting-row"><span><strong>Revalidation du statut distant</strong><small>Toutes les @DurationLabel(SecurityPolicy.RemoteStatusRevalidationInterval). Configuration exploitant.</small></span><span class="switch on" role="switch" aria-checked="true" aria-readonly="true"><span></span></span></div></div></section>
            <section class="panel settings-panel readonly-settings"><div class="section-heading"><div><p class="eyebrow">Configuration effective</p><h2>Runtime</h2></div><span class="status progress">Lecture seule</span></div><dl><div><dt>Stockage</dt><dd>@(Configuration["Database:Provider"] ?? "Sqlite")</dd></div><div><dt>Concurrence worker</dt><dd>@RuntimeOptions.Value.WorkerConcurrency</dd></div><div><dt>Bail / renouvellement</dt><dd>@Seconds(RuntimeOptions.Value.LeaseDuration) / @Seconds(RuntimeOptions.Value.LeaseRenewalInterval)</dd></div><div><dt>Timeout handler</dt><dd>@DurationLabel(RuntimeOptions.Value.AttemptTimeout)</dd></div></dl><p><PhosphorIcon Name="gear" Size="15" /> Ces paramètres sont validés au démarrage et modifiés par l’exploitant.</p></section>
            @if (Saved) { <div class="inline-success" role="status"><PhosphorIcon Name="check-circle" Size="18" /> Réglages enregistrés</div> }
            @if (!string.IsNullOrWhiteSpace(Error)) { <div class="form-error" role="alert">Les réglages ont été refusés (@Error).</div> }
            <div class="settings-actions"><button class="primary-button" type="submit">Enregistrer les réglages</button></div>
        </form>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "saved")] public string? SavedValue { get; set; }
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }
    private bool Saved => SavedValue == "1";
    private bool _allowed;
    private PresentationSettings _settings = PresentationSettings.Default;
    protected override async Task OnInitializedAsync()
    {
        var actor = await Identity.GetRequiredAsync();
        _allowed = (await Authorization.AuthorizeAsync(new(actor, WorkflowPermissions.ManageAccess), CancellationToken.None)).Allowed;
        if (!_allowed) return;
        _settings = (await SettingsStore.ReadAsync(CancellationToken.None)).Value ?? PresentationSettings.Default;
    }
    private static string DurationLabel(TimeSpan value) => value.TotalHours >= 1 && value.TotalMinutes % 60 == 0 ? $"{value.TotalHours:0} heure{(value.TotalHours > 1 ? "s" : string.Empty)}" : $"{value.TotalMinutes:0} minutes";
    private static string Seconds(TimeSpan value) => $"{value.TotalSeconds:0} s";
}
