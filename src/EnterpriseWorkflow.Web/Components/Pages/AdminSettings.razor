@inject WorkflowUiLocalizer Ui
@page "/admin/settings"
@attribute [Authorize]
@using EnterpriseWorkflow.Runtime
@using Microsoft.Extensions.Options
@inject IPresentationSettingsStore SettingsStore
@inject WorkflowBrandingOptions Branding
@inject IAuthorizationProvider Authorization
@inject WorkflowWebIdentityAccessor Identity
@inject IConfiguration Configuration
@inject SecurityPolicyOptions SecurityPolicy
@inject IOptions<WorkflowRuntimeOptions> RuntimeOptions

<PageTitle>@Ui["Réglages · Enterprise Workflow"]</PageTitle>
<div class="content content-small admin-content">
    <div class="admin-page-intro"><div><p class="eyebrow">@Ui["Installation"]</p><h1>@Ui["Réglages"]</h1><p>@Ui["Personnalisez l’interface et consultez la configuration effective."]</p></div></div>
    @if (!_allowed) { <section class="panel empty-state"><h2>@Ui["Accès refusé"]</h2><p>@Ui["La permission de gestion des accès est requise."]</p></section> }
    else
    {
        <form method="post" action="/admin/settings/update" class="settings-form"><AntiforgeryToken /><input type="hidden" name="revision" value="@_settings.Revision" />@if (!Branding.CanEdit(WorkflowBrandingFields.TimeZone)) { <input type="hidden" name="timeZoneId" value="@_settings.TimeZoneId" /> }<input type="hidden" name="culture" value="@_settings.Culture" />
            <section class="panel settings-panel"><div class="section-heading"><div><p class="eyebrow">@Ui["Apparence"]</p><h2>@Ui["Identité de l’installation"]</h2></div></div><div class="settings-fields"><label>@Ui["Nom affiché"]<input readonly="@(!Branding.CanEdit(WorkflowBrandingFields.DisplayName))" name="displayName" value="@_settings.DisplayName" required maxlength="160" /></label><label>@Ui["Chemin du logo"]<input name="logoResourcePath" value="@_settings.LogoResourcePath" readonly="@(!Branding.CanEdit(WorkflowBrandingFields.Logo))" /></label><label>@Ui["Fuseau horaire"]<select name="timeZoneId" disabled="@(!Branding.CanEdit(WorkflowBrandingFields.TimeZone))" required><option selected="@(_settings.TimeZoneId == "Africa/Kinshasa")">Africa/Kinshasa</option><option selected="@(_settings.TimeZoneId == "UTC")">UTC</option>@if (_settings.TimeZoneId is not "Africa/Kinshasa" and not "UTC") { <option selected>@_settings.TimeZoneId</option> }</select></label><div class="setting-row"><span><strong>@Ui["Couleur d’accent"]</strong><small>@Ui["Utilisée pour les actions et les états sélectionnés."]</small></span><label class="color-swatch"><span class="color-preview" style="background:@_settings.AccentColor"></span><input readonly="@(!Branding.CanEdit(WorkflowBrandingFields.AccentColor))" name="accentColor" value="@_settings.AccentColor" required pattern="#[0-9A-Fa-f]{6}" aria-label="@(Ui["Couleur d’accent"])" /></label></div></div></section>
            <section class="panel settings-panel"><div class="section-heading"><div><p class="eyebrow">@Ui["Sessions"]</p><h2>@Ui["Politique de sécurité"]</h2></div></div><div class="settings-fields"><div class="field-grid"><label>@Ui["Inactivité maximale"]<select disabled><option>@DurationLabel(SecurityPolicy.IdleSessionTimeout)</option></select></label><label>@Ui["Durée maximale"]<select disabled><option>@DurationLabel(SecurityPolicy.AbsoluteSessionLifetime)</option></select></label></div><div class="setting-row"><span><strong>@Ui["Revalidation du statut distant"]</strong><small>@Ui["Toutes les"] @DurationLabel(SecurityPolicy.RemoteStatusRevalidationInterval). Configuration exploitant.</small></span><span class="switch on" role="switch" aria-checked="true" aria-readonly="true"><span></span></span></div></div></section>
            <section class="panel settings-panel readonly-settings"><div class="section-heading"><div><p class="eyebrow">@Ui["Configuration effective"]</p><h2>Runtime</h2></div><span class="status progress">@Ui["Lecture seule"]</span></div><dl><div><dt>@Ui["Stockage"]</dt><dd>@(Configuration["Database:Provider"] ?? "Sqlite")</dd></div><div><dt>@Ui["Concurrence worker"]</dt><dd>@RuntimeOptions.Value.WorkerConcurrency</dd></div><div><dt>@Ui["Bail / renouvellement"]</dt><dd>@Seconds(RuntimeOptions.Value.LeaseDuration) / @Seconds(RuntimeOptions.Value.LeaseRenewalInterval)</dd></div><div><dt>@Ui["Timeout handler"]</dt><dd>@DurationLabel(RuntimeOptions.Value.AttemptTimeout)</dd></div></dl><p><PhosphorIcon Name="gear" Size="15" /> Ces paramètres sont validés au démarrage et modifiés par l’exploitant.</p></section>
            @if (Saved) { <div class="inline-success" role="status"><PhosphorIcon Name="check-circle" Size="18" /> Réglages enregistrés</div> }
            @if (!string.IsNullOrWhiteSpace(Error)) { <div class="form-error" role="alert">Les réglages ont été refusés (@Error).</div> }
            <div class="settings-actions"><button class="primary-button" type="submit">@Ui["Enregistrer les réglages"]</button></div>
        </form>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "saved")] public string? SavedValue { get; set; }
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }
    private bool Saved => SavedValue == "1";
    private bool _allowed;
    private PresentationSettings _settings = PresentationSettings.Default;
    protected override async Task OnInitializedAsync()
    {
        var actor = await Identity.GetRequiredAsync();
        _allowed = (await Authorization.AuthorizeAsync(new(actor, WorkflowPermissions.ManageAccess), CancellationToken.None)).Allowed;
        if (!_allowed) return;
        _settings = (await SettingsStore.ReadAsync(CancellationToken.None)).Value ?? PresentationSettings.Default;
    }
    private static string DurationLabel(TimeSpan value) => value.TotalHours >= 1 && value.TotalMinutes % 60 == 0 ? $"{value.TotalHours:0} heure{(value.TotalHours > 1 ? "s" : string.Empty)}" : $"{value.TotalMinutes:0} minutes";
    private static string Seconds(TimeSpan value) => $"{value.TotalSeconds:0} s";
}
