@using System.Text.Json

@foreach (var field in Form.Fields)
{
    var name = $"field.{field.Id.Value}";
    var errors = Errors.Where(error => error.FieldId == field.Id.Value).ToArray();
    <label for="@name">
        <span>@field.Label@if (field.Required) { <span aria-hidden="true"> *</span> }</span>
        @switch (field.Kind)
        {
            case WorkflowFormFieldKind.File:
                <input id="@name" aria-invalid="@(errors.Length > 0 ? "true" : null)" aria-describedby="@(errors.Length > 0 ? name + "-error" : null)" type="file" disabled multiple="@(field.FileSpecification?.MaximumFiles > 1)" accept="@string.Join(",", field.FileSpecification?.AllowedExtensions ?? [])"
                       required="@(field.Required && !HasUploadedFiles(name))" data-media-upload="@field.Id.Value" data-media-max-files="@field.FileSpecification?.MaximumFiles" />
                <input name="@name" type="hidden" value="@(SubmittedValues?.GetValueOrDefault(name) ?? "[]")" data-media-reference="@field.Id.Value" />
                <small role="status" aria-live="polite" data-media-status="@field.Id.Value">@(HasUploadedFiles(name) ? "Pièces jointes conservées pour cette soumission." : "Aucun fichier sélectionné.")</small>
                break;
            case WorkflowFormFieldKind.LongText:
                <textarea id="@name" aria-invalid="@(errors.Length > 0 ? "true" : null)" aria-describedby="@(errors.Length > 0 ? name + "-error" : null)" name="@name" required="@field.Required" maxlength="@field.MaximumLength" rows="4">@Value(field)</textarea>
                break;
            case WorkflowFormFieldKind.Date:
                <input id="@name" aria-invalid="@(errors.Length > 0 ? "true" : null)" aria-describedby="@(errors.Length > 0 ? name + "-error" : null)" name="@name" type="date" value="@Value(field)" required="@field.Required" />
                break;
            case WorkflowFormFieldKind.Number:
                <input id="@name" aria-invalid="@(errors.Length > 0 ? "true" : null)" aria-describedby="@(errors.Length > 0 ? name + "-error" : null)" name="@name" type="number" value="@Value(field)" required="@field.Required"
                       min="@field.Minimum" max="@field.Maximum" step="any" />
                break;
            case WorkflowFormFieldKind.Boolean:
                <span class="checkbox-field"><input id="@name" aria-invalid="@(errors.Length > 0 ? "true" : null)" aria-describedby="@(errors.Length > 0 ? name + "-error" : null)" name="@name" type="checkbox" value="true" checked="@BooleanValue(field)" /><span>Oui</span></span>
                break;
            case WorkflowFormFieldKind.Choice:
                <select id="@name" aria-invalid="@(errors.Length > 0 ? "true" : null)" aria-describedby="@(errors.Length > 0 ? name + "-error" : null)" name="@name" required="@field.Required">
                    <option value="">Sélectionner…</option>
                    @foreach (var option in field.Options)
                    {
                        <option value="@option.Value" selected="@(Value(field) == option.Value)">@option.Label</option>
                    }
                </select>
                break;
            default:
                <input id="@name" aria-invalid="@(errors.Length > 0 ? "true" : null)" aria-describedby="@(errors.Length > 0 ? name + "-error" : null)" name="@name" type="text" value="@Value(field)" required="@field.Required"
                       minlength="@field.MinimumLength" maxlength="@field.MaximumLength" />
                break;
        }
        @if (errors.Length > 0) { <span id="@(name + "-error")" class="field-validation-error">@foreach (var error in errors) { <span>@WorkflowValidationMessages.Message(error, Form)</span> }</span> }
        @if (!string.IsNullOrWhiteSpace(field.HelpText)) { <small class="field-help">@field.HelpText</small> }
    </label>
}

@code {
    [Parameter, EditorRequired] public WorkflowFormDefinition Form { get; set; } = null!;
    [Parameter] public CanonicalJson? Values { get; set; }

    [Parameter] public IReadOnlyList<WorkflowFormError> Errors { get; set; } = [];
    [Parameter] public IReadOnlyDictionary<string, string>? SubmittedValues { get; set; }

    private bool HasUploadedFiles(string name)
    {
        try { using var value = JsonDocument.Parse(SubmittedValues?.GetValueOrDefault(name) ?? "[]"); return value.RootElement.ValueKind == JsonValueKind.Array && value.RootElement.GetArrayLength() > 0; }
        catch (JsonException) { return false; }
    }

    private string? Value(WorkflowFormField field)
    {
        if (SubmittedValues?.TryGetValue("field." + field.Id.Value, out var submitted) == true) return submitted;
        if (Values is null) return null;
        var root = Values.ToJsonElement();
        if (!root.TryGetProperty(field.Id.Value, out var value)) return null;
        return value.ValueKind switch
        {
            JsonValueKind.String => value.GetString(),
            JsonValueKind.Number => value.GetRawText(),
            _ => null,
        };
    }

    private bool BooleanValue(WorkflowFormField field)
    {
        if (SubmittedValues is not null) return SubmittedValues.GetValueOrDefault("field." + field.Id.Value) == "true";
        if (Values is null) return false;
        var root = Values.ToJsonElement();
        return root.TryGetProperty(field.Id.Value, out var value) && value.ValueKind is JsonValueKind.True;
    }
}
