@inject IPresentationSettingsStore SettingsStore
@inject WorkflowBrandingOptions Branding
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="@Assets["_content/EnterpriseWorkflow.Web/enterprise-workflow.css"]" />
    @if (Branding.FaviconPath is { } favicon) { <link rel="icon" href="@favicon" /> }
    @if (Branding.StylesheetPath is { } stylesheet) { <link rel="stylesheet" href="@stylesheet" /> }
    <HeadOutlet />
</head>
<body style="@(Branding.CssVariables(_settings.AccentColor))">
    <Routes />
    <script src="_framework/blazor.web.js"></script>
    <script src="@Assets["_content/EnterpriseWorkflow.Web/enterprise-workflow.js"]"></script>
</body>
</html>

@code {
    private PresentationSettings _settings = PresentationSettings.Default;
    protected override async Task OnInitializedAsync() =>
        _settings = (await SettingsStore.ReadAsync(CancellationToken.None)).Value ?? PresentationSettings.Default;
}
