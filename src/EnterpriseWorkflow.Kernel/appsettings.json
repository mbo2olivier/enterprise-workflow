{
  "Database": {
    "Provider": "Sqlite",
    "MigrationMode": "Validate"
  },
  "Installation": {
    "Id": "enterprise-workflow"
  },
  "Modules": {
    "Directories": []
  },
  "Security": {
    "AuthenticationProvider": "local",
    "Ldap": {
      "Enabled": false
    },
    "Policy": {
      "IdleSessionTimeout": "00:30:00",
      "AbsoluteSessionLifetime": "08:00:00",
      "RemoteStatusRevalidationInterval": "00:05:00",
      "MaximumFailedAccessAttempts": 5,
      "LockoutDuration": "00:15:00",
      "LoginRateLimitPermitCount": 10,
      "LoginRateLimitWindow": "00:01:00",
      "PasswordMinimumLength": 12,
      "PasswordMaximumLength": 1024,
      "MaximumRequestBodyBytes": 65536
    }
  }
}
